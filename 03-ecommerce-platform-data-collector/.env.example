TAOBAO_BROWSER_PORT=9333
TAOBAO_BROWSER_PATH=
TAOBAO_CHROME_MAJOR_VERSION=
TAOBAO_USER_DATA_DIR=artifacts/chrome-profile
TAOBAO_HEADLESS=false
TAOBAO_DEFAULT_WAIT=20
TAOBAO_MAX_RETRIES=3
TAOBAO_LOG_LEVEL=INFO
TAOBAO_SCREENSHOT_DIR=artifacts/screenshots
TAOBAO_READ_ONLY_BEHAVIOR=true
TAOBAO_MIN_PAUSE=3
TAOBAO_MAX_PAUSE=6
TAOBAO_COMMENT_MIN_PAUSE=3
TAOBAO_COMMENT_MAX_PAUSE=5
TAOBAO_PRODUCT_MIN_PAUSE=5
TAOBAO_PRODUCT_MAX_PAUSE=8
TAOBAO_PAGE_MIN_PAUSE=30
TAOBAO_PAGE_MAX_PAUSE=60
TAOBAO_MAX_SCROLLS=2
TAOBAO_MAX_TAB_VIEWS=2
TAOBAO_RETRY_BASE_DELAY=10
TAOBAO_POLL_INTERVAL=0.05
TAOBAO_LOGIN_WAIT_TIMEOUT=180
TAOBAO_VERIFICATION_WAIT_TIMEOUT=300
TAOBAO_LIVE_BEHAVIOR=true
